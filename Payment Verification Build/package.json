{
  "name": "aether-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Aether Arena - Solana payment verification, auto-delivery, and a merchant dashboard. Next.js 16 App Router, Prisma, @solana/web3.js.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:push:sqlite": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@solana/web3.js": "^1.98.4",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
